# Copy to .env or export these variables before starting the server.
# Runtime data and an encryption key are generated under .runtime by default.
OPEN_GARMIN_DATA_DIR=.runtime
# For PostgreSQL: postgresql+psycopg://user:password@host/database
# OPEN_GARMIN_DATABASE_URL=sqlite:///.runtime/app.db
# Set to 1 behind HTTPS in a hosted installation.
OPEN_GARMIN_SECURE_COOKIES=0
# OPEN_GARMIN_ALLOWED_ORIGINS=https://your-domain.example
# Public registrations default to disabled. Enable only after preparing hosting.
OPEN_GARMIN_ALLOW_REGISTRATION=0
